option(TETHER_ENABLE_ASAN "Instrument validation builds with AddressSanitizer" OFF)
if(TETHER_ENABLE_ASAN)
    if(NOT MSVC)
        message(FATAL_ERROR "The ASan preset is currently validated with MSVC only")
    endif()
    # MSVC ASan is incompatible with runtime checks and incremental linking.
    foreach(language IN ITEMS C CXX)
        string(REGEX REPLACE "/RTC[1su]+" "" CMAKE_${language}_FLAGS_DEBUG "${CMAKE_${language}_FLAGS_DEBUG}")
        string(REPLACE "/ZI" "/Zi" CMAKE_${language}_FLAGS_DEBUG "${CMAKE_${language}_FLAGS_DEBUG}")
    endforeach()
    add_compile_options(/fsanitize=address /Zi)
    add_link_options(/INCREMENTAL:NO)
    get_filename_component(compiler_bin "${CMAKE_C_COMPILER}" DIRECTORY)
    file(GLOB asan_runtimes "${compiler_bin}/clang_rt.asan*dynamic*.dll")
    if(NOT asan_runtimes)
        message(FATAL_ERROR "MSVC ASan runtime not found beside ${CMAKE_C_COMPILER}")
    endif()
    foreach(configuration IN ITEMS Debug Release RelWithDebInfo)
        file(COPY ${asan_runtimes} DESTINATION "${CMAKE_BINARY_DIR}/${configuration}")
    endforeach()
endif()
