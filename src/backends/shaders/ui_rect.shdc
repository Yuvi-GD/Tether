@vs vs
in vec2 pos;
in vec2 uv;
in vec4 color;
in vec2 size;
in float radius;

out vec2 v_uv;
out vec4 v_color;
out vec2 v_size;
out float v_radius;

layout(binding=0) uniform vs_params {
    vec2 res;
    vec2 pad;
};

void main() {
    float ndc_x = (pos.x / res.x) * 2.0 - 1.0;
    float ndc_y = 1.0 - (pos.y / res.y) * 2.0;
    gl_Position = vec4(ndc_x, ndc_y, 0.5, 1.0);
    v_uv = uv;
    v_color = color;
    v_size = size;
    v_radius = radius;
}
@end

@fs fs
in vec2 v_uv;
in vec4 v_color;
in vec2 v_size;
in float v_radius;

out vec4 frag_color;

float round_rect_sdf(vec2 p, vec2 b, float r) {
    vec2 q = abs(p) - b + vec2(r, r);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r;
}

void main() {
    vec2 half_size = v_size * 0.5;
    vec2 p = (v_uv * v_size) - half_size;
    float d = round_rect_sdf(p, half_size, v_radius);
    
    // Simple anti-aliasing based on SDF
    float alpha = 1.0 - smoothstep(-1.0, 0.5, d); 
    
    // Premultiplied alpha for standard blending
    frag_color = vec4(v_color.rgb * v_color.a * alpha, v_color.a * alpha);
}
@end

@program ui_rect vs fs

@vs vs_blit
in vec2 pos;
in vec2 uv;
out vec2 v_uv;
void main() {
    gl_Position = vec4(pos, 0.5, 1.0);
    v_uv = uv;
}
@end

@fs fs_blit
layout(binding=0) uniform texture2D tex;
layout(binding=0) uniform sampler smp;
in vec2 v_uv;
out vec4 frag_color;
void main() {
    frag_color = texture(sampler2D(tex, smp), v_uv);
}
@end

@program ui_blit vs_blit fs_blit

